spring.datasource.username=spring
spring.datasource.password=${SPRING_DATASOURCE_PASSWORD}
spring.datasource.url=${SPRING_DATASOURCE_URL}

google.captcha.private=${GOOGLE_CAPTCHA_PRIVATE}

spring.mail.username=${SPRING_MAIL_USERNAME}
spring.mail.password=${SPRING_MAIL_PASSWORD}
spring.mail.host=${SPRING_MAIL_HOST}
spring.mail.port=465
custom.mail.smtp.customerSupport=${spring.mail.username}
spring.mail.properties.mail.smtp.auth=true

api.customization.website.url=${API_WEBSITE_URL}
api.devMode=false

# Minecraft accounts (optional): players log in to Minecraft with their WoW account
minecraft.auth.enabled=${MINECRAFT_AUTH_ENABLED:false}
minecraft.auth.name=${MINECRAFT_AUTH_NAME:Minecraft}
# host[:port] players connect to; empty = this website's host
minecraft.auth.game-server=${MINECRAFT_GAME_SERVER:}
# refuse, or suffix with mc-launch's Paper plugin (real account with one of our names plays as Name(2))
minecraft.auth.name-clash=${MINECRAFT_AUTH_NAMECLASH:refuse}
